---
/*
  Taste-Deal /games (Showcase, Hybrid – System v2 aus DESIGN.md bleibt):
  kind software · hero triptych (Headline · Collage aus drei Sets des Reaktionstests · Button) ·
  palette blue-black-cornflower · type instrument · radius sharp · nav-centre · footer-dark ·
  close-type · rhythm dark-band (Abschnitt „Runde“) · buttons pill · mark wordmark ·
  moment: iris-opens (Abschnitt „Runde“, vom canvas auf das Band)
*/
import qrcode from 'qrcode-generator';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Icon from '@/components/Icon.astro';
import Uuid from '@/components/Uuid.astro';
import { games } from '@/games/registry';
import { reaction } from '@/games/reaction/meta';
import { makePlan, toFields } from '@/games/reaction/logic';
import { ms, sec } from '@/games/format';
import { cyrb128, rngFor } from '@/lib/seed/prng';
import { buildShareUrl, encodeResult } from '@/lib/share/codec';
import { base64UrlToBytes } from '@/lib/uuid/bytes';
import { t } from '@/i18n';

const g = t.games;
const x = g.index;
const R = g.reaction;

// --- Echte Werte, beim Build aus einer festen UUID berechnet ---
const demo = '4f2a91c3-7d0e-4b8a-9c51-e36f0b2d7a18';
const plan = makePlan(demo);
const mine = toFields([231, 264, 219, 288, 247], 0);
const theirs = toFields([248, 271, 236, 302, 258], 0);
const meNick = '9b3d';
const themNick = '7c1e';
const code = encodeResult(demo, { gameId: reaction.id, fields: mine, nick: meNick });
const shareUrl = buildShareUrl('https://uuidea.de', 'reaction', demo, code);
const codeBytes = base64UrlToBytes(code)!;
const crc = ((codeBytes[codeBytes.length - 2]! << 8) | codeBytes[codeBytes.length - 1]!)
  .toString(16)
  .padStart(4, '0');
const words = cyrb128(`${demo}:reaction:main`).map((w) => w.toString(16).padStart(8, '0'));
const maxBar = Math.max(...mine.slice(3), ...theirs.slice(3));
const pairs = mine.slice(3).map((v, i) => {
  const o = theirs[3 + i] ?? 0;
  return { v, o, wv: Math.round((v / maxBar) * 100), wo: Math.round((o / maxBar) * 100) };
});
const waitPct = (w: number) => Math.round(((w - 1200) / 3000) * 100);

// QR-Code des Beispiel-Links (statisch als SVG-Pfad)
const q = qrcode(0, 'M');
q.addData(shareUrl, 'Byte');
q.make();
const qn = q.getModuleCount();
let qd = '';
for (let y = 0; y < qn; y++)
  for (let xx = 0; xx < qn; xx++) if (q.isDark(y, xx)) qd += `M${xx} ${y}h1v1h-1z`;

// Vorschauen der kommenden Spiele, ebenfalls aus der UUID gemischt
const memColors = [
  '#5ab9fc',
  '#5ce1e6',
  '#74e0a8',
  '#f2c46d',
  '#ff8f70',
  '#c3cad6',
  '#3b82c4',
  '#2fa58c',
];
const memDeck = rngFor(demo, 'memory').shuffle([...memColors, ...memColors]);
const memOpen = new Set([2, 9]);
const sortTiles = rngFor(demo, 'sort').shuffle(Array.from({ length: 16 }, (_, i) => i));
const seqRng = rngFor(demo, 'sequence');
const seqLit = seqRng.int(0, 3);
const hexRng = rngFor(demo, 'hexcolor');
const hex = () =>
  '#' + Array.from({ length: 3 }, () => hexRng.int(32, 223).toString(16).padStart(2, '0')).join('');
const hexTarget = hex();
const hexOptions = hexRng.shuffle([hexTarget, hex(), hex()]);

const cardOf = Object.fromEntries(games.map((gm) => [gm.slug, gm]));
const soonSlugs = ['memory', 'sort', 'sequence', 'hexcolor'] as const;
---

<BaseLayout title={g.title} description={g.description} ogImage="/og/games.png" showcase>
  <link slot="head" rel="modulepreload" href="/assets/moments/moments.js" />
  <link slot="head" rel="modulepreload" href="/assets/moments/lib.js" />

  <!-- 1 · Hero: triptych -->
  <section class="screen hero tri" data-enter aria-labelledby="hero-h">
    <div class="wrap">
      <div class="hero-text grid-12 tri-grid">
        <div class="tri-copy">
          <h1 id="hero-h" class="tri-h1 enter">
            {x.h1}
          </h1>
          <p class="tri-lead enter">{x.lead}</p>
        </div>

        <div class="tri-collage enter" id="collage" role="img" aria-label={x.collageLabel}>
          <!-- Set 1: Runde läuft -->
          <div class="tri-set is-on" data-set>
            <div class="pc pc-pad" data-c={plan.colors[2]}>
              <span class="pc-eyebrow">{R.pad.idle(3, 5)}</span>
              <span class="pc-go">{R.pad.go}</span>
            </div>
            <div class="pc pc-seed">
              <span class="pc-label">{g.shell.seedLabel}</span>
              <span class="pc-uuid">
                <Uuid value={demo} />
              </span>
            </div>
            <div class="pc pc-steps">
              <span class="pc-label">{g.shell.perRound}</span>
              <ol>
                {mine.slice(3).map((v, i) => (
                  <li class:list={[i === 2 && 'is-now']} data-c={plan.colors[i]}>
                    <span>{R.round(i + 1)}</span>
                    <b>{i < 2 ? ms(v) : '–'}</b>
                  </li>
                ))}
              </ol>
            </div>
          </div>

          <!-- Set 2: Ergebnis im Vergleich -->
          <div class="tri-set" data-set aria-hidden="true">
            <div class="pc pc-result">
              <span class="pc-label">{g.shell.result}</span>
              <span class="pc-score">{ms(mine[0]!)}</span>
              <span class="pc-sub">
                {R.avg} · {R.best} {ms(mine[1]!)}
              </span>
            </div>
            <div class="pc pc-verdict">
              <span class="badge badge-ok">✓</span>
              <span>{reaction.verdict(mine, theirs, themNick)}</span>
            </div>
            <div class="pc pc-bars">
              <p class="pc-legend">
                <span class="is-me">{g.shell.you}</span>
                <span class="is-them">{themNick}</span>
              </p>
              <ol>
                {pairs.map((p) => (
                  <li>
                    <span class="bar is-me" data-w={p.wv}>
                      <b>{ms(p.v)}</b>
                    </span>
                    <span class="bar is-them" data-w={p.wo}>
                      <b>{ms(p.o)}</b>
                    </span>
                  </li>
                ))}
              </ol>
            </div>
          </div>

          <!-- Set 3: Link, QR-Code, Herkunft der Runde -->
          <div class="tri-set" data-set aria-hidden="true">
            <div class="pc pc-link">
              <span class="pc-label">{g.shell.share.title}</span>
              <span class="pc-url" translate="no">
                {shareUrl}
              </span>
            </div>
            <div class="pc pc-qr">
              <svg
                viewBox={`-3 -3 ${qn + 6} ${qn + 6}`}
                shape-rendering="crispEdges"
                aria-hidden="true"
              >
                <rect x="-3" y="-3" width={qn + 6} height={qn + 6} fill="#e9edf3"></rect>
                <path d={qd} fill="#0a0d14"></path>
              </svg>
            </div>
            <div class="pc pc-trace">
              <span class="pc-label">{g.shell.trace}</span>
              <dl>
                {plan.waits.map((w, i) => (
                  <div>
                    <dt>{R.round(i + 1)}</dt>
                    <dd>
                      <i data-c={plan.colors[i]}></i>
                      {sec(w)}
                    </dd>
                  </div>
                ))}
              </dl>
            </div>
          </div>

          <button
            type="button"
            class="loop-pause tri-pause"
            id="collage-pause"
            aria-label="Animation pausieren"
            aria-pressed="false"
            hidden
          >
            <svg viewBox="0 0 14 14" aria-hidden="true">
              <path d="M3 2h3v10H3zM8 2h3v10H8z"></path>
            </svg>
          </button>
        </div>

        <div class="tri-cta enter">
          <a href="/games/reaction" class="btn btn-primary btn-lg tri-btn">
            {x.cta}
            <Icon name="arrow" />
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- 2 · Die fünf Spiele -->
  <section class="screen list" id="spiele" aria-labelledby="list-h">
    <div class="wrap">
      <h2 id="list-h" class="t-h2">
        {x.listTitle} <span class="text-ink-muted">{x.listMuted}</span>
      </h2>
      <p class="t-lead mt-4 max-w-[56ch]">{x.listLead}</p>

      <div class="grid-12 cards mt-10">
        <a href="/games/reaction" class="card gcard gcard-live">
          <div class="gfrag gfrag-rx" data-ui aria-hidden="true">
            <div class="mini-pad">
              <span>{R.pad.wait}</span>
            </div>
            <ol class="mini-steps">
              {mine.slice(3).map((v, i) => (
                <li data-c={plan.colors[i]}>
                  <span>{R.round(i + 1)}</span>
                  <b>{i < 3 ? ms(v) : '–'}</b>
                </li>
              ))}
            </ol>
          </div>
          <div class="gcard-body">
            <h3 class="t-h3 flex items-center justify-between gap-3">
              {cardOf.reaction!.name}
              <Icon name="arrow" class="gcard-arrow" />
            </h3>
            <p class="mt-1.5 text-[15px] text-ink-muted">{cardOf.reaction!.tagline}</p>
          </div>
        </a>

        <ul class="soon-list">
          {soonSlugs.map((slug) => (
            <li class="soon-row">
              <div class:list={['soon-frag', `gfrag-${slug}`]} data-ui aria-hidden="true">
                {slug === 'memory' && (
                  <div class="mem">
                    {memDeck.map((c, i) => (
                      <span class:list={[memOpen.has(i) && 'is-open']} data-hex={c} />
                    ))}
                  </div>
                )}
                {slug === 'sort' && (
                  <div class="srt">
                    {sortTiles.map((n) => (n === 0 ? <span class="is-empty" /> : <span>{n}</span>))}
                  </div>
                )}
                {slug === 'sequence' && (
                  <div class="seq">
                    {[1, 2, 3, 4].map((c, i) => (
                      <span data-c={c} class:list={[i === seqLit && 'is-lit']} />
                    ))}
                  </div>
                )}
                {slug === 'hexcolor' && (
                  <div class="hx">
                    <span class="hx-swatch" data-hex={hexTarget} />
                    <span class="hx-opts">
                      {hexOptions.map((h) => (
                        <span>{h}</span>
                      ))}
                    </span>
                  </div>
                )}
              </div>
              <div class="soon-text">
                <p class="t-h3 flex items-center gap-3 text-ink">
                  {cardOf[slug]!.name}
                  <span class="badge">{g.soon}</span>
                </p>
                <p class="mt-1 text-[15px] text-ink-muted">{cardOf[slug]!.tagline}</p>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- 3 · Seed (dunkles Band, Moment iris-opens) -->
  <section
    class="screen band seedsec"
    id="runde"
    aria-labelledby="seed-h"
    data-moment="iris-opens"
    data-moment-opts='{"from": "base"}'
  >
    <div class="wrap grid-12 seed-grid">
      <div class="seed-copy">
        <h2 id="seed-h" class="t-h2">
          {x.seedTitle}
        </h2>
        <p class="t-lead mt-4">{x.seedLead}</p>
        <ol class="steps mt-8">
          {x.seedSteps.map((s, i) => (
            <li>
              <span class="font-mono text-ink-subtle">{String(i + 1).padStart(2, '0')}</span>
              <div>
                <p class="text-ink">{s.k}</p>
                <p class="mt-1 text-[15px]">{s.v}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>

      <div class="card pipe-card" data-ui aria-hidden="true">
        <div class="pn pn-uuid">
          <span class="pn-k">UUID</span>
          <span class="pn-v">
            <Uuid value={demo} />
          </span>
        </div>
        <span class="pl">
          <i></i>
        </span>
        <div class="pn">
          <span class="pn-k">cyrb128(„…:reaction:main“)</span>
          <span class="pn-words font-mono">
            {words.map((w, i) => (
              <span class={`s${i + 1}`}>{w}</span>
            ))}
          </span>
        </div>
        <span class="pl">
          <i></i>
        </span>
        <div class="pn">
          <span class="pn-k">sfc32 → {R.waits}</span>
          <ol class="waits">
            {plan.waits.map((w, i) => (
              <li>
                <span class="font-mono">{R.round(i + 1)}</span>
                <span class="wbar" data-w={waitPct(w)} data-c={plan.colors[i]}>
                  <i></i>
                </span>
                <b class="font-mono">{sec(w)}</b>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </div>
  </section>

  <!-- 4 · Herausforderung per Link -->
  <section class="screen linksec" id="herausforderung" aria-labelledby="link-h">
    <div class="wrap">
      <h2 id="link-h" class="t-h2">
        {x.linkTitle}
      </h2>
      <p class="t-lead mt-4 max-w-[60ch]">{x.linkLead}</p>

      <div class="grid-12 link-grid mt-10">
        <div class="card anat" data-ui aria-hidden="true">
          <p class="anat-url font-mono">
            <span class="u-game">uuidea.de/games/reaction</span>
            <span class="u-dim">?id=</span>
            <span class="u-id">{demo}</span>
            <span class="u-dim">#r=</span>
            <span class="u-code">{code}</span>
          </p>
          <ul class="anat-keys">
            <li class="k-game">{x.linkParts.game}</li>
            <li class="k-id">{x.linkParts.uuid}</li>
            <li class="k-code">{x.linkParts.code}</li>
          </ul>
          <p class="anat-head">{x.decoded}</p>
          <dl class="anat-rows">
            <div>
              <dt>{x.decodedRows.version}</dt>
              <dd>v1</dd>
            </div>
            <div>
              <dt>{x.decodedRows.game}</dt>
              <dd>01 · {reaction.name}</dd>
            </div>
            <div>
              <dt>{x.decodedRows.score}</dt>
              <dd>
                {ms(mine[0]!)} · {mine.slice(3).join(' / ')}
              </dd>
            </div>
            <div>
              <dt>{x.decodedRows.nick}</dt>
              <dd>{meNick}</dd>
            </div>
            <div>
              <dt>{x.decodedRows.crc}</dt>
              <dd>
                0x{crc} <span class="text-success">✓ {x.crcOk}</span>
              </dd>
            </div>
          </dl>
        </div>

        <div class="card opened" data-ui aria-hidden="true">
          <span class="badge badge-accent-2">
            {g.shell.challengeFrom} {meNick}
          </span>
          <p class="opened-lead">{g.shell.challengeLead(meNick, ms(mine[0]!))}</p>
          <div class="opened-seed">
            <span class="pc-label">{g.shell.seedLabel}</span>
            <span class="opened-uuid">
              <Uuid value={demo} />
            </span>
          </div>
          <p class="opened-target">
            <span>
              {g.shell.vs} {meNick}
            </span>
            <b class="font-mono text-accent-2">{ms(mine[0]!)}</b>
          </p>
          <span class="opened-btn">{g.shell.start}</span>
        </div>
      </div>
    </div>
  </section>

  <Fragment slot="close">
    <h2 class="close-title">{x.closeTitle}</h2>
    <p class="t-lead prose-w mt-5">{x.closeLead}</p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a href="/games/reaction" class="btn btn-primary btn-lg max-sm:w-full">
        {x.cta}
        <Icon name="arrow" />
      </a>
    </div>
  </Fragment>
</BaseLayout>

<script is:inline type="module" src="/assets/moments/moments.js"></script>

<script>
  import { initCollageLoop } from '@/scripts/collage-loop';

  // Breiten und Farben aus data-* (CSSOM statt Style-Attribut wegen der CSP)
  document.querySelectorAll<HTMLElement>('[data-w]').forEach((el) => {
    el.style.setProperty('--w', String(Number(el.dataset.w) / 100));
  });
  document.querySelectorAll<HTMLElement>('[data-hex]').forEach((el) => {
    el.style.setProperty('--hex', el.dataset.hex ?? '#5ab9fc');
  });

  const collage = document.getElementById('collage');
  const pause = document.getElementById('collage-pause') as HTMLButtonElement | null;
  if (collage && pause) initCollageLoop(collage, pause);
</script>

<style>
  /* Signalfarben aus dem Segment-Spektrum */
  [data-c='1'] {
    --sig: var(--color-seg-1);
  }
  [data-c='2'] {
    --sig: var(--color-seg-2);
  }
  [data-c='3'] {
    --sig: var(--color-seg-3);
  }
  [data-c='4'] {
    --sig: var(--color-seg-4);
  }
  [data-c='5'] {
    --sig: var(--color-seg-5);
  }
  .pc-label {
    display: block;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.04em;
    color: var(--color-ink-subtle);
  }

  /* ---------- Hero: triptych ---------- */
  .tri {
    overflow: hidden;
  }
  .tri-grid {
    display: flex;
    flex-direction: column;
  }
  .tri-h1 {
    font-size: clamp(40px, 1.143vw + 35.54px, 52px);
    line-height: 1.04;
    letter-spacing: -0.034em;
    font-weight: 500;
  }
  .tri-lead {
    margin-top: 16px;
    max-width: 34ch;
    font-size: 16px;
    color: var(--color-ink-muted);
  }
  .tri-collage {
    position: relative;
    flex: 1 1 0;
    min-height: 300px;
    margin-block: 24px;
    container-type: size;
    border-radius: var(--radius-xl);
    background:
      radial-gradient(70% 60% at 30% 20%, rgb(90 185 252 / 0.08), transparent 70%),
      var(--color-surface-1);
    border: 1px solid var(--color-hairline);
  }
  .tri-cta .tri-btn {
    width: 100%;
  }
  @media (min-width: 1024px) {
    .tri {
      padding-top: calc(var(--nav-h) + 56px);
      padding-bottom: 64px;
      justify-content: flex-start;
    }
    .tri-grid {
      display: grid;
      height: calc(100svh - var(--nav-h) - 120px);
      grid-template-rows: 1fr auto 1fr;
    }
    .tri-copy {
      grid-column: 1 / span 4;
      grid-row: 1;
      align-self: end;
    }
    .tri-collage {
      grid-column: 6 / span 7;
      grid-row: 1 / span 3;
      margin: 0;
      min-height: 0;
    }
    .tri-cta {
      grid-column: 1 / span 4;
      grid-row: 2;
      margin-top: 24px;
    }
    .tri-cta .tri-btn {
      width: auto;
    }
  }
  @media (min-width: 1280px) {
    .tri-grid {
      grid-template-rows: minmax(0, 1fr);
    }
    .tri-copy {
      grid-column: 1 / span 3;
      grid-row: 1;
      align-self: start;
    }
    .tri-collage {
      grid-column: 4 / span 6;
      grid-row: 1;
    }
    .tri-cta {
      grid-column: 10 / span 3;
      grid-row: 1;
      align-self: center;
      display: flex;
      justify-content: flex-end;
      margin: 0;
    }
  }

  .tri-set {
    position: absolute;
    inset: 0;
  }
  .tri-collage:global(.is-cycling) > .tri-set {
    transition:
      opacity 0.7s var(--ease-out),
      visibility 0.7s;
  }
  .tri-set:not(:global(.is-on)) {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }
  .pc {
    position: absolute;
    overflow: hidden;
    border-radius: var(--radius-lg);
    background: var(--color-surface-2);
    border: 1px solid var(--color-hairline-strong);
    box-shadow: 0 18px 44px -20px rgb(0 0 0 / 0.7);
    padding: clamp(10px, 3cqi, 18px);
    font-size: clamp(11px, 2.2cqi, 14px);
    color: var(--color-ink);
  }
  /* Set 1 */
  .pc-pad {
    left: 4%;
    top: 5%;
    width: 92%;
    height: 50%;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 6px;
    background: var(--sig);
    border-color: var(--sig);
    color: var(--color-on-accent);
  }
  .pc-eyebrow {
    font-family: var(--font-mono);
    font-size: clamp(11px, 2cqi, 13px);
    opacity: 0.75;
  }
  .pc-go {
    font-size: clamp(28px, 8cqi, 52px);
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1;
  }
  .pc-seed {
    left: 4%;
    top: 60%;
    width: 50%;
  }
  .pc-uuid {
    display: block;
    margin-top: 6px;
    font-size: 1.95cqi;
    line-height: 1.5;
    white-space: nowrap;
  }
  .pc-uuid :global(.uuid) {
    word-break: normal;
  }
  .pc-steps {
    left: 58%;
    top: 60%;
    width: 38%;
    height: 36%;
  }
  .pc-steps ol {
    display: grid;
    gap: 4px;
    margin-top: 8px;
  }
  .pc-steps li {
    display: flex;
    justify-content: space-between;
    padding: 4px 8px;
    border-radius: var(--radius-sm);
    border-left: 2px solid var(--color-hairline-strong);
    font-family: var(--font-mono);
  }
  .pc-steps li:nth-child(-n + 2) {
    border-left-color: var(--sig);
  }
  .pc-steps li.is-now {
    background: var(--color-surface-3);
    border-left-color: var(--color-ink-subtle);
  }
  .pc-steps li span {
    color: var(--color-ink-subtle);
  }
  .pc-steps li b {
    font-weight: 400;
  }
  /* Set 2 */
  .pc-result {
    left: 4%;
    top: 5%;
    width: 52%;
  }
  .pc-score {
    display: block;
    margin-top: 6px;
    font-family: var(--font-mono);
    font-size: clamp(24px, 7cqi, 44px);
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .pc-sub {
    display: block;
    margin-top: 8px;
    color: var(--color-ink-muted);
  }
  .pc-verdict {
    left: 4%;
    top: 46%;
    width: 32%;
    display: grid;
    gap: 8px;
    justify-items: start;
    color: var(--color-ink);
  }
