---
import '@/styles/global.css';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { t } from '@/i18n';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  noindex?: boolean;
  /** Showcase-Seite (Taste-Skill): Sektionen bringen den Header-Abstand selbst mit, Footer als Schluss-Screen */
  showcase?: boolean;
}
const {
  title = t.meta.defaultTitle,
  description = t.meta.defaultDescription,
  ogImage = '/og/default.png',
  noindex = false,
  showcase = false,
} = Astro.props;
const canonical = new URL(Astro.url.pathname.replace(/\.html$/, ''), Astro.site);
const ogUrl = new URL(ogImage, Astro.site);
---

<!doctype html>
<html lang="de" data-type="software">
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      document.documentElement.classList.add('m-enter');
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="page-type" content="software" />
    <meta name="site-kind" content="software" />
    <meta name="theme-color" content="#07080c" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="uuidea" />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <slot name="head" />
  </head>
  <body>
    <Header />
    <main id="main" tabindex="-1" class:list={[!showcase && 'pt-nav']}>
      <slot />
    </main>
    <Footer closing={showcase}>
      <slot name="close" />
    </Footer>
    <div id="toast" class="toast" role="status" aria-live="polite"></div>

    <script>
      import { initGlobal } from '@/scripts/global';
      initGlobal();
    </script>
  </body>
</html>

<style>
  .pt-nav {
    padding-top: calc(var(--nav-h) + env(safe-area-inset-top));
  }
  .toast {
    position: fixed;
    left: 50%;
    bottom: calc(var(--bottom-h) + 16px);
    z-index: 70;
    max-width: calc(100vw - 32px);
    padding: 12px 16px;
    border-radius: var(--radius-md);
    background: var(--color-surface-3);
    border: 1px solid var(--color-hairline-strong);
    color: var(--color-ink);
    font-size: 14px;
    box-shadow: 0 12px 40px -12px rgb(0 0 0 / 0.6);
    transform: translate(-50%, 12px);
    opacity: 0;
    pointer-events: none;
    transition:
      opacity 200ms var(--ease-out),
      transform 360ms var(--ease-out);
  }
  .toast:not(:empty).show {
    opacity: 1;
    transform: translate(-50%, 0);
  }
  @media (min-width: 768px) {
    .toast {
      bottom: 24px;
    }
  }
</style>
