---
import { t } from '@/i18n';
import Icon from './Icon.astro';
import { navItems, isActive } from './nav';

const path = Astro.url.pathname;
---

<header class="nav site-header">
  <div class="wrap relative flex h-full items-center justify-between gap-4">
    <a href="#main" class="skip-link">
      {t.a11y.skip}
    </a>
    <a href="/" class="wordmark" aria-label="uuidea – Startseite">
      <span class="wordmark-glyph" aria-hidden="true">
        <i></i>
        <i></i>
        <i></i>
        <i></i>
        <i></i>
      </span>
      <span>uuidea</span>
    </a>
    <nav aria-label={t.a11y.mainNav} class="hidden md:block">
      <ul class="flex items-center gap-1">
        {navItems.slice(1).map((item) => (
          <li>
            <a
              href={item.href}
              class="top-link"
              aria-current={isActive(path, item.href) ? 'page' : undefined}
            >
              {t.nav[item.key]}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
  <div class="spectrum-line opacity-50" aria-hidden="true"></div>
</header>

<nav class="bottom-nav md:hidden" aria-label={t.a11y.mainNav}>
  <ul>
    {navItems.map((item) => (
      <li>
        <a href={item.href} aria-current={isActive(path, item.href) ? 'page' : undefined}>
          <Icon name={item.icon} size={22} />
          <span>{t.nav[item.key]}</span>
        </a>
      </li>
    ))}
  </ul>
</nav>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 40;
    height: var(--nav-h);
    padding-top: env(safe-area-inset-top);
    box-sizing: content-box;
    background: color-mix(in oklab, var(--color-canvas) 78%, transparent);
    backdrop-filter: blur(14px) saturate(140%);
    -webkit-backdrop-filter: blur(14px) saturate(140%);
  }
  .site-header > .spectrum-line {
    position: absolute;
    inset: auto 0 0 0;
  }
  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    color: var(--color-ink);
    font-weight: 600;
    font-size: 18px;
    letter-spacing: -0.02em;
    text-decoration: none;
  }
  .wordmark-glyph {
    display: inline-flex;
    gap: 2px;
    align-items: center;
  }
  .wordmark-glyph i {
    display: block;
    height: 14px;
    border-radius: 2px;
  }
  .wordmark-glyph i:nth-child(1) {
    width: 8px;
    background: var(--color-seg-1);
  }
  .wordmark-glyph i:nth-child(2) {
    width: 4px;
    background: var(--color-seg-2);
  }
  .wordmark-glyph i:nth-child(3) {
    width: 4px;
    background: var(--color-seg-3);
  }
  .wordmark-glyph i:nth-child(4) {
    width: 4px;
    background: var(--color-seg-4);
  }
  .wordmark-glyph i:nth-child(5) {
    width: 12px;
    background: var(--color-seg-5);
  }
  .top-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 14px;
    border-radius: var(--radius-md);
    font-size: 15px;
    font-weight: 500;
    color: var(--color-ink-subtle);
    text-decoration: none;
    transition:
      color 200ms var(--ease-out),
      background-color 200ms var(--ease-out);
  }
  .top-link:hover {
    color: var(--color-ink);
    background: var(--color-surface-2);
  }
  .top-link[aria-current='page'] {
    color: var(--color-ink);
  }

  .bottom-nav {
    position: fixed;
    inset: auto 0 0 0;
    z-index: 50;
    padding-bottom: env(safe-area-inset-bottom);
    padding-inline: env(safe-area-inset-left) env(safe-area-inset-right);
    background: color-mix(in oklab, var(--color-surface-1) 82%, transparent);
    backdrop-filter: blur(16px) saturate(140%);
    -webkit-backdrop-filter: blur(16px) saturate(140%);
    border-top: 1px solid var(--color-hairline);
  }
  .bottom-nav ul {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
  }
  .bottom-nav a {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 3px;
    height: 64px;
    font-size: 11.5px;
    font-weight: 500;
    color: var(--color-ink-subtle);
    text-decoration: none;
    transition: color 200ms var(--ease-out);
  }
  .bottom-nav a:active {
    color: var(--color-ink);
  }
  .bottom-nav a[aria-current='page'] {
    color: var(--color-ink);
  }
  .bottom-nav a[aria-current='page'] :global(svg) {
    color: var(--color-accent);
  }
  .bottom-nav a[aria-current='page']::before {
    content: '';
    position: absolute;
    top: 0;
    width: 28px;
    height: 2px;
    border-radius: 0 0 2px 2px;
    background: var(--spectrum);
  }
  .bottom-nav a:focus-visible {
    outline-offset: -4px;
  }
</style>
