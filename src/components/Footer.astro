---
/**
 * Footer. Mit `closing` (Showcase-Seiten) ist er ein eigener Bildschirm:
 * Reihe 1 = der Close (Slot), Reihe 2 = Links und Rechtliches (Taste-Skill: footer.closing).
 */
import { t } from '@/i18n';

interface Props {
  closing?: boolean;
}
const { closing = false } = Astro.props;
---

<footer class:list={['site-footer', closing && 'closing screen']}>
  <div class="wrap footer-wrap">
    {closing && <div class="close-row">{<slot />}</div>}
    <div class="footer-row">
      <div class="ghost uuid uuid-xl" aria-hidden="true" data-session-ghost>
        00000000-0000-4000-8000-000000000000
      </div>
      <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
        <div class="space-y-2">
          <p class="eyebrow">{t.footer.sessionLabel}</p>
          <p class="text-[15px]">
            <span class="uuid text-ink-muted" data-session-uuid translate="no">
              …
            </span>
          </p>
          <p class="t-serif text-xl text-ink">{t.footer.tagline}</p>
        </div>
        <div class="space-y-2 text-sm md:text-right">
          <p class="text-ink-muted">{t.footer.noTracking}</p>
          <ul class="flex gap-6 md:justify-end">
            <li>
              <a class="foot-link" href="/impressum">
                {t.footer.impressum}
              </a>
            </li>
            <li>
              <a class="foot-link" href="/datenschutz">
                {t.footer.datenschutz}
              </a>
            </li>
          </ul>
          <p class="font-mono text-xs text-ink-muted">© {new Date().getFullYear()} uuidea.de</p>
        </div>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    overflow: hidden;
    border-top: 1px solid var(--color-hairline);
    margin-top: 96px;
    padding: 48px 0 calc(32px + var(--bottom-h));
  }
  @media (min-width: 768px) {
    .site-footer {
      padding-bottom: 48px;
    }
  }
  .site-footer.closing {
    margin-top: 0;
    border-top: 0;
    padding: calc(var(--nav-h) + 32px) 0 calc(32px + var(--bottom-h));
  }
  @media (min-width: 768px) {
    .site-footer.closing {
      padding-bottom: 72px;
    }
  }
  .closing .footer-wrap {
    flex: 1;
    display: grid;
    grid-template-rows: 1fr auto;
    gap: 32px;
  }
  .close-row {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .footer-row {
    position: relative;
    padding-top: 24px;
    border-top: 1px solid var(--color-hairline);
  }
  .ghost {
    position: absolute;
    left: 0;
    bottom: 100%;
    margin-bottom: 8px;
    color: var(--color-ink);
    opacity: 0.05;
    pointer-events: none;
    user-select: none;
  }
  .site-footer:not(.closing) .ghost {
    display: none;
  }
  .foot-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--color-ink-muted);
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 4px;
    transition:
      color 200ms var(--ease-out),
      text-decoration-color 200ms var(--ease-out);
  }
  .foot-link:hover {
    color: var(--color-ink);
    text-decoration-color: currentColor;
  }
</style>
