---
import { t } from '@/i18n';
---

<footer class="site-footer">
  <div class="footer-ghost uuid" aria-hidden="true" data-session-ghost>
    00000000-0000-4000-8000-000000000000
  </div>
  <div class="container-page relative py-12 md:py-16">
    <div class="flex flex-col gap-8 md:flex-row md:items-end md:justify-between">
      <div class="space-y-3">
        <p class="eyebrow">{t.footer.sessionLabel}</p>
        <p class="text-[15px] break-all">
          <span class="uuid text-ink-muted" data-session-uuid translate="no">
            …
          </span>
        </p>
        <p class="t-serif text-xl text-ink">{t.footer.tagline}</p>
      </div>
      <div class="space-y-3 text-sm md:text-right">
        <p class="text-ink-subtle">{t.footer.noTracking}</p>
        <ul class="flex gap-2 md:justify-end">
          <li>
            <a class="btn btn-ghost -ml-3 md:ml-0" href="/impressum">
              {t.footer.impressum}
            </a>
          </li>
          <li>
            <a class="btn btn-ghost" href="/datenschutz">
              {t.footer.datenschutz}
            </a>
          </li>
        </ul>
        <p class="font-mono text-xs text-ink-subtle">© {new Date().getFullYear()} uuidea.de</p>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    overflow: hidden;
    border-top: 1px solid var(--color-hairline);
    margin-top: 96px;
    padding-bottom: var(--bottom-h);
  }
  @media (min-width: 768px) {
    .site-footer {
      padding-bottom: 0;
    }
  }
  .footer-ghost {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    font-size: clamp(64px, 14vw, 180px);
    line-height: 1;
    white-space: nowrap;
    word-break: normal;
    color: var(--color-ink);
    opacity: 0.035;
    pointer-events: none;
    user-select: none;
  }
</style>
